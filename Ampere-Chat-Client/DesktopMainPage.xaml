<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Ampere_Chat_Client"
             x:Class="Ampere_Chat_Client.DesktopMainPage"
             Title="Ampere Chat"
             BackgroundColor="{DynamicResource PageBackgroundColor}">

    <Grid ColumnDefinitions="350, *">
        <!-- Левая колонка -->
        <Grid Grid.Column="0" BackgroundColor="{DynamicResource CardBackground}">
            <Grid RowDefinitions="Auto, *">
                <!-- Шапка -->
                <Grid Padding="10" BackgroundColor="{DynamicResource Primary}" >
                    <Grid ColumnDefinitions="Auto, *, Auto">
                        <!-- Аватар (заменить на инициал или иконку) -->
                        <Border Grid.Column="0"
                            StrokeShape="RoundRectangle 20"
                            BackgroundColor="#512BD4"
                            WidthRequest="35"
                            HeightRequest="35"
                            HorizontalOptions="Center"
                            VerticalOptions="Center">
                            <Label Text="S" 
                               TextColor="White"
                               FontSize="18"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                        </Border>

                        <HorizontalStackLayout Grid.Column="2" Spacing="15" HorizontalOptions="End" VerticalOptions="Center">
                            <!-- Кнопка "Новый чат" (плюс) -->
                            <Image Source="plus_desktop_light.png"
                                   WidthRequest="24" HeightRequest="24"
                                   Aspect="AspectFit">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnNewChatClicked" />
                                </Image.GestureRecognizers>
                            </Image>

                            <!-- Кнопка "Настройки" -->
                            <Image Source="{AppThemeBinding Light=settings_desktop_light.png, Dark=settings_desktop_light.png}"
                                   WidthRequest="24" HeightRequest="24"
                                   Aspect="AspectFit">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnSettingsClicked" />
                                </Image.GestureRecognizers>
                            </Image>
                        </HorizontalStackLayout>
                    </Grid>
                </Grid>

                <!-- Список чатов -->
                <local:ChatsView Grid.Row="1" x:Name="ChatsListView" />
            </Grid>
        </Grid>

        <!-- Правая колонка -->
        <Grid Grid.Column="1" BackgroundColor="{DynamicResource PageBackgroundColor}">
            <ContentView x:Name="ChatDetailContainer">
                <!-- Заглушка -->
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="10">
                    <Label Text="Выберите чат" FontSize="24" TextColor="{DynamicResource TextColor}" />
                    <Label Text="Чтобы начать переписку" FontSize="16" TextColor="{DynamicResource SecondaryTextColor}" />
                </VerticalStackLayout>
            </ContentView>
        </Grid>
    </Grid>
</ContentPage>