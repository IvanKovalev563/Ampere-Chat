<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:Ampere_Chat_Client.Converters"
             x:Class="Ampere_Chat_Client.ChatPage"
             Title="{Binding ChatName}"
             x:Name="ChatPageRoot">

    <ContentPage.Resources>
        <converters:UserIdToColorConverter x:Key="UserIdToColorConverter" />
        <converters:UserIdToHorizontalOptionsConverter x:Key="UserIdToHorizontalOptionsConverter" />
    </ContentPage.Resources>

    <Grid RowDefinitions="*, Auto">
        <CollectionView Grid.Row="0" x:Name="MessagesCollectionView"
                        ItemsSource="{Binding Messages}"
                        VerticalOptions="FillAndExpand">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="5,2" HorizontalOptions="{Binding user_id, Converter={StaticResource UserIdToHorizontalOptionsConverter}}">
                        <Frame CornerRadius="20" Padding="10" BackgroundColor="{Binding user_id, Converter={StaticResource UserIdToColorConverter}}">
                            <VerticalStackLayout>
                                <Label Text="{Binding text}" 
                                       TextColor="Black" 
                                       FontSize="14" />
                                <Label Text="{Binding sent_at, StringFormat='{0:HH:mm}'}" 
                                       TextColor="Gray" 
                                       FontSize="10"
                                       HorizontalOptions="End" />
                            </VerticalStackLayout>
                        </Frame>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Grid Grid.Row="1" Padding="10" ColumnDefinitions="*, Auto">
            <Entry x:Name="MessageEntry" 
                   Placeholder="Введите сообщение..." 
                   Grid.Column="0"
                   ReturnType="Send"
                   Completed="OnMessageEntryCompleted" />
            <Grid Grid.Column="1" WidthRequest="38" HeightRequest="38">
                <Border StrokeThickness="0"
                BackgroundColor="#512BD4"
                StrokeShape="RoundRectangle 20">
                    <Image Source="send.png"
                   Aspect="AspectFit"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   WidthRequest="20"
                   HeightRequest="20">
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSendClicked" />
                        </Image.GestureRecognizers>
                    </Image>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</ContentPage>