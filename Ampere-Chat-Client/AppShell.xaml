<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Ampere_Chat_Client.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Ampere_Chat_Client"
    Shell.FlyoutBehavior="Disabled"
    Title="Ampere Chat">

    <TabBar>
        <Tab Title="Чаты" Icon="chat.png">
            <ShellContent ContentTemplate="{DataTemplate local:ChatsPage}" />
        </Tab>
        <Tab Title="Настройки" Icon="settings.png">
            <ShellContent ContentTemplate="{DataTemplate local:SettingsPage}" />
        </Tab>
    </TabBar>

</Shell>